# Werkzeuge: generierter Index, gehoert nicht ins Repository
.tokensave/

# Arbeitsunterlagen, bleiben lokal
CLAUDE.md
KONZEPT.md

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/
.DS_Store

# Laufzeitdaten von gogdl - niemals ins Repository.
# Entstehen, sobald das Tool mit --dest auf dieses Verzeichnis läuft.
.gogdl/
.trash/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.part
auth.json

# Heruntergeladene Spiele, falls jemand --dest hierher zeigt
setup_*
gog_*
*.bin

# Local tool state
# Verzeichnisinhalt statt Verzeichnis: sonst steigt Git nicht hinein und die
# Ausnahme darunter bliebe wirkungslos.
.claude/*
# Die Broker-Absicherung gehört ins Repo, nicht auf eine einzelne Maschine.
!.claude/settings.json
# Das Arbeitsmodell ebenso: Rollen und Startbefehl definieren, wie hier
# gearbeitet wird. Ungetrackt lägen sie auf genau einer Platte.
!.claude/agents/
!.claude/agents/*.md
!.claude/commands/
!.claude/commands/*.md
!.claude/skills/
!.claude/skills/**
# Nicht umdrehen: .claude/worktrees trägt zeitweise zweistellige Gigabyte, und
# settings.local.json ist maschinenspezifisch.
